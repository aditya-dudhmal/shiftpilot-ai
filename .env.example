# ShiftPilot AI — copy to .env and fill in only what you use.
# Demo mode works with this file empty: no API key is required.
# Never commit a real .env — it is git-ignored.

# Database (default: SQLite file backend/shiftpilot.db)
DATABASE_URL=sqlite:///./shiftpilot.db

# Optional LLM provider for the natural-language assistant.
# Leave both blank for demo mode (built-in rule parser).
# LLM_PROVIDER: auto | openai | anthropic | none
LLM_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=  # defaults: gpt-4o-mini / claude-3-5-haiku-latest

# Monday of the week schedules cover (YYYY-MM-DD)
WEEK_START=2026-11-30

# Frontend: API base URL (empty = same origin / Vite dev proxy)
VITE_API_URL=
